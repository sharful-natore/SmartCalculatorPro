<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- 1. TOP HEADER BAR: App Logo + Brand + Location + Mode Toggle + Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Brand Name + Location Pin & Name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_app_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="ToolsMate"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Divider Dot -->
            <TextView
                android:id="@+id/widget_header_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:text="•"
                android:textColor="#0284C7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Location Pin & Name -->
            <LinearLayout
                android:id="@+id/widget_location_click_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_icon_location"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="Location"
                    android:src="@drawable/ic_widget_location" />

                <TextView
                    android:id="@+id/widget_location_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ঢাকা"
                    android:textColor="#0284C7"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right: Theme Toggle & Refresh Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_btn_theme_toggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_badge_bg"
                android:contentDescription="Toggle Light/Dark Theme"
                android:padding="4dp"
                android:src="@drawable/ic_widget_moon" />

            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_badge_bg"
                android:contentDescription="Refresh Widget"
                android:padding="4dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sub-header Date Line -->
    <TextView
        android:id="@+id/widget_date_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="3dp"
        android:gravity="start"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="১৮ আগস্ট ২০২৬ | ৩ ভাদ্র ১৪৩২ | ৬ সফর ১৪ ৪৮ মঙ্গলবার"
        android:textColor="#475569"
        android:textSize="9.2sp" />

    <!-- 2. CARD 1: WEATHER DATA CARD (Expands dynamically to fill height) -->
    <LinearLayout
        android:id="@+id/widget_weather_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="3dp"
        android:background="@drawable/widget_card_inner_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="9dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Weather"
                android:src="@drawable/ic_widget_weather" />

            <TextView
                android:id="@+id/widget_weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="২৮°C"
                android:textColor="#0284C7"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_weather_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="আংশিক মেঘলা • অনুভূত ৩০°C"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_weather_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="আর্দ্রতা ৬৮% • বাতাস ১০ কিমি/ঘ"
                    android:textColor="#475569"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <!-- Sunrise Row -->
            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_sunrise_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="Sunrise"
                    android:src="@drawable/ic_widget_sunrise" />

                <TextView
                    android:id="@+id/widget_sunrise_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সূর্যোদয়ঃ "
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_sunrise_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৫:৩২"
                    android:textColor="#FDE047"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Sunset Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_sunset_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="Sunset"
                    android:src="@drawable/ic_widget_sunset" />

                <TextView
                    android:id="@+id/widget_sunset_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সূর্যাস্তঃ "
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_sunset_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="১৮:২৪"
                    android:textColor="#F87171"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. CARD 2: PRAYER & FASTING TIMINGS CARD (Expands dynamically to fill height) -->
    <!-- 3. ISLAMIC PRAYER & WAQT INFO -->
    <LinearLayout
        android:id="@+id/widget_card_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_marginBottom="3dp"
        android:background="@drawable/widget_card_inner_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="9dp"
        android:paddingVertical="3dp">

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Top Prayer Section: 2 Columns (Current Waqt on Left, Next Waqt on Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- LEFT BLOCK: CURRENT WAQT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Line 1: Clock Icon + Active Waqt Title + Checkmark Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_icon_clock"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="Time Icon"
                        android:src="@drawable/ic_widget_clock" />

                    <TextView
                        android:id="@+id/widget_active_waqt_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="বর্তমানঃ মাগরিব"
                        android:textColor="#0284C7"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <!-- Quick Icon-only Checkmark Action Button -->
                    <LinearLayout
                        android:id="@+id/widget_btn_waqt_check"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/widget_check_btn_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/widget_icon_waqt_check"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="Mark Prayer Done"
                            android:src="@drawable/ic_widget_check_empty" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Line 2: Timer Icon + Active Waqt Time Duration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_icon_timer_active"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="Timer Icon"
                        android:src="@drawable/ic_widget_timer" />

                    <TextView
                        android:id="@+id/widget_active_waqt_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="৬:৩১ PM - ৭:১০ PM"
                        android:textColor="#0369A1"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Subtle Vertical Separator -->
            <ImageView
                android:id="@+id/widget_waqt_divider"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="6dp"
                android:background="#E2E8F0"
                android:contentDescription="Divider" />

            <!-- RIGHT BLOCK: NEXT WAQT (Right Aligned, Icons on Right) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <!-- Line 1: Next Waqt Title + Clock Icon on Right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_next_waqt_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="পরবর্তীঃ এশা"
                        android:textColor="#475569"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_icon_clock_next"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="3dp"
                        android:contentDescription="Time Icon"
                        android:src="@drawable/ic_widget_clock" />
                </LinearLayout>

                <!-- Line 2: Next Waqt Time Duration + Timer Icon on Right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_next_waqt_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="৭:১১ PM - ৪:২৫ AM"
                        android:textColor="#334155"
                        android:textSize="9.5sp" />

                    <ImageView
                        android:id="@+id/widget_icon_timer_next"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="3dp"
                        android:contentDescription="Timer Icon"
                        android:src="@drawable/ic_widget_timer" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Row: Sehri & Iftar Timings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Sehri (Left Aligned, Icon on Left) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_icon_sehri"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="Sunrise"
                    android:src="@drawable/ic_widget_sunrise" />

                <TextView
                    android:id="@+id/widget_sehri_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="সেহরিঃ ৪:২৬ AM"
                    android:textColor="#059669"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Iftar (Right Aligned, Icon on Right) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_iftar_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="ইফতারঃ ৬:৫৬ PM"
                    android:textColor="#DC2626"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_icon_iftar"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="3dp"
                    android:contentDescription="Sunset"
                    android:src="@drawable/ic_widget_sunset" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 4. BOTTOM QUICK ACTION PILLS (4 Capsules) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 1. Calculator -->
        <LinearLayout
            android:id="@+id/widget_btn_calc"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_shortcut_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="3dp">

            <ImageView
                android:id="@+id/widget_icon_calc"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="Calculator"
                android:src="@drawable/ic_widget_calc" />

            <TextView
                android:id="@+id/widget_btn_calc_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ক্যালকুলেটর"
                android:textColor="#0284C7"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Calendar -->
        <LinearLayout
            android:id="@+id/widget_btn_calendar"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_shortcut_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="3dp">

            <ImageView
                android:id="@+id/widget_icon_calendar"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="Calendar"
                android:src="@drawable/ic_widget_calendar" />

            <TextView
                android:id="@+id/widget_btn_calendar_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ক্যালেন্ডার"
                android:textColor="#0284C7"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Market List -->
        <LinearLayout
            android:id="@+id/widget_btn_market"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_shortcut_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="3dp">

            <ImageView
                android:id="@+id/widget_icon_market"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="Market"
                android:src="@drawable/ic_widget_market" />

            <TextView
                android:id="@+id/widget_btn_market_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="বাজার ফর্দ"
                android:textColor="#0284C7"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Islamic Tools -->
        <LinearLayout
            android:id="@+id/widget_btn_islamic"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_shortcut_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="3dp">

            <ImageView
                android:id="@+id/widget_icon_islamic"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="Islamic"
                android:src="@drawable/ic_widget_mosque" />

            <TextView
                android:id="@+id/widget_btn_islamic_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ইসলামিক"
                android:textColor="#0284C7"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
